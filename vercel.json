{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/website/",
      "permanent": false
    },
    {
      "source": "/100empresas/",
      "destination": "/100clientesideais/",
      "permanent": false
    }
  ],
  "functions": {
    "api/motor-3clientes.js": {
      "maxDuration": 60
    },
    "api/cron-relatorios.js": {
      "maxDuration": 300
    },
    "api/cron-lista100.js": {
      "maxDuration": 300
    },
    "api/cron-lembretes-webinar.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron-relatorios/",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-lista100/",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-lembretes-webinar/",
      "schedule": "*/5 * * * *"
    }
  ]
}